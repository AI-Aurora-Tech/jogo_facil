# --- App (navegador) ---
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=
# Seu WhatsApp de suporte: "Configurar pagamento" e recuperação de senha (DDI+DDD+número, só dígitos)
# Pode usar o nome SUPPORT_WHATSAPP ou VITE_SUPPORT_WHATSAPP. Precisa de novo deploy ao mudar.
SUPPORT_WHATSAPP=5511999999999

# --- Servidor (funções /api na Vercel). NUNCA use prefixo VITE_ aqui. ---
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Texto aleatório longo (ex.: openssl rand -hex 32)
SESSION_SECRET=

# Asaas: sandbox primeiro, production quando estiver tudo testado
ASAAS_ENV=sandbox
ASAAS_API_KEY=
# Mesmo token configurado no webhook do Asaas
ASAAS_WEBHOOK_TOKEN=

# % da taxa do jogo que fica com a plataforma (0 = tudo para o dono do campo)
PLATFORM_FEE_PERCENT=0
# URL pública do app (usada nos links de convite)
APP_URL=https://seu-app.vercel.app

# Opcional: e-mail do código de recuperação de senha (https://resend.com).
# Sem isso, o "Esqueci a senha" leva para o WhatsApp de suporte.
RESEND_API_KEY=
# Remetente de um domínio verificado no Resend
EMAIL_FROM=Jogo Fácil <nao-responda@seudominio.com>
