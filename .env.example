# --- App (navegador) ---
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=
# Seu WhatsApp de suporte para recuperação de senha (DDI+DDD+número, só dígitos)
# Pode usar o nome SUPPORT_WHATSAPP ou VITE_SUPPORT_WHATSAPP. Precisa de novo deploy ao mudar.
SUPPORT_WHATSAPP=5511999999999

# --- Servidor (funções /api na Vercel). NUNCA use prefixo VITE_ aqui. ---
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Texto aleatório longo (ex.: openssl rand -hex 32)
SESSION_SECRET=

# URL pública do app (usada nos links de convite)
APP_URL=https://seu-app.vercel.app

# E-mail do código de recuperação de senha (https://resend.com). Usado só para troca de senha.
# Sem a chave, o "Esqueci a senha" leva para o WhatsApp de suporte.
RESEND_API_KEY=
# Opcional. Padrão: "Jogo Fácil <onboarding@resend.dev>", que só entrega para o e-mail dono da conta Resend.
# Para enviar a qualquer usuário, verifique um domínio no Resend e use um remetente dele:
# EMAIL_FROM=Jogo Fácil <nao-responda@seudominio.com.br>
